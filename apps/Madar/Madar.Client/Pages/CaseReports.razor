@page "/reports/cases"
@attribute [Authorize]
@inject CaseSearchApiClient SearchClient
@inject MadarApiClient ApiClient

<PageTitle>بحث وتقارير الحالات | مدار</PageTitle>

<MudStack Spacing="4" dir="rtl">
    <div>
        <MudText Typo="Typo.h3">بحث وتقارير الحالات</MudText>
        <MudText Typo="Typo.body1">
            ابحث ضمن الحالات المسموح لك برؤيتها، واعرض ملخصًا تشغيليًا من نفس نطاق الصلاحيات والفلاتر.
        </MudText>
    </div>

    <MudPaper Elevation="0" Outlined="true" Class="pa-5">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField T="string"
                              Label="بحث بالعنوان أو الوصف أو معرف الحالة"
                              Variant="Variant.Outlined"
                              @bind-Value="_query"
                              Disabled="_loading" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="string" Label="نوع الحالة" Variant="Variant.Outlined"
                           @bind-Value="_caseType" Clearable="true" Disabled="_loading">
                    @foreach (var option in CaseTypeOptions)
                    {
                        <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="string" Label="الأولوية" Variant="Variant.Outlined"
                           @bind-Value="_priority" Clearable="true" Disabled="_loading">
                    @foreach (var option in PriorityOptions)
                    {
                        <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="string" Label="حالة المعالجة" Variant="Variant.Outlined"
                           @bind-Value="_status" Clearable="true" Disabled="_loading">
                    @foreach (var option in StatusOptions)
                    {
                        <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="string" Label="حالة SLA" Variant="Variant.Outlined"
                           @bind-Value="_slaState" Clearable="true" Disabled="_loading">
                    @foreach (var option in SlaOptions)
                    {
                        <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="Guid?" Label="القسم" Variant="Variant.Outlined"
                           @bind-Value="_departmentId" Clearable="true" Disabled="_loading">
                    @foreach (var department in _departments)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)department.Id)">@department.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="int" Label="حجم الصفحة" Variant="Variant.Outlined"
                           @bind-Value="_limit" Disabled="_loading">
                    <MudSelectItem T="int" Value="25">25</MudSelectItem>
                    <MudSelectItem T="int" Value="50">50</MudSelectItem>
                    <MudSelectItem T="int" Value="100">100</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudDatePicker Label="من تاريخ الإنشاء (UTC)"
                               DateFormat="yyyy-MM-dd"
                               Variant="Variant.Outlined"
                               @bind-Date="_createdFromDate"
                               Disabled="_loading" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudDatePicker Label="إلى تاريخ الإنشاء (UTC)"
                               DateFormat="yyyy-MM-dd"
                               Variant="Variant.Outlined"
                               @bind-Date="_createdToDate"
                               Disabled="_loading" />
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Spacing="2" Class="mt-4">
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       Disabled="_loading" OnClick="SearchFromStartAsync">
                @(_loading ? "جارٍ البحث..." : "بحث")
            </MudButton>
            <MudButton Variant="Variant.Outlined" Disabled="_loading" OnClick="ResetAsync">
                مسح الفلاتر
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_response is not null)
    {
        <MudGrid>
            <MudItem xs="6" md="2">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.caption">الإجمالي</MudText>
                    <MudText Typo="Typo.h4">@_response.Summary.Total</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="2">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.caption">غير مسندة</MudText>
                    <MudText Typo="Typo.h4">@_response.Summary.Unassigned</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="2">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.caption">جديدة</MudText>
                    <MudText Typo="Typo.h4">@_response.Summary.New</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="2">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.caption">قيد المعالجة</MudText>
                    <MudText Typo="Typo.h4">@_response.Summary.InProgress</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="2">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.caption">محلولة</MudText>
                    <MudText Typo="Typo.h4">@_response.Summary.Resolved</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="2">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.caption">SLA مخترق</MudText>
                    <MudText Typo="Typo.h4">@_response.Summary.SlaBreached</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @if (_response.Items.Count == 0)
        {
            <MudAlert Severity="Severity.Info">لا توجد حالات مطابقة للفلاتر الحالية ضمن صلاحياتك.</MudAlert>
        }
        else
        {
            <MudTable Items="_response.Items" Hover="true" Dense="true" Elevation="0" Outlined="true">
                <HeaderContent>
                    <MudTh>العنوان</MudTh>
                    <MudTh>النوع</MudTh>
                    <MudTh>الأولوية</MudTh>
                    <MudTh>الحالة</MudTh>
                    <MudTh>SLA</MudTh>
                    <MudTh>الإنشاء</MudTh>
                    <MudTh>آخر تحديث</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    <MudTd DataLabel="العنوان">@item.Title</MudTd>
                    <MudTd DataLabel="النوع">@DisplayCaseType(item.CaseType)</MudTd>
                    <MudTd DataLabel="الأولوية">@DisplayPriority(item.Priority)</MudTd>
                    <MudTd DataLabel="الحالة">@DisplayStatus(item.Status)</MudTd>
                    <MudTd DataLabel="SLA">@DisplaySlaState(item.SlaState)</MudTd>
                    <MudTd DataLabel="الإنشاء">@item.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                    <MudTd DataLabel="آخر تحديث">@item.UpdatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" Variant="Variant.Text"
                                   Href="@($"/cases/{item.Id:D}")">فتح</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-3">
            <MudText Typo="Typo.body2">
                عرض @DisplayRangeStart()–@DisplayRangeEnd() من @_response.Total
            </MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" Disabled="@(_loading || _offset == 0)"
                       OnClick="PreviousPageAsync" Class="ms-2">السابق</MudButton>
            <MudButton Variant="Variant.Outlined" Disabled="@(_loading || !HasNextPage)"
                       OnClick="NextPageAsync">التالي</MudButton>
        </MudStack>
    }
</MudStack>

@code {
    private static readonly (string Value, string Label)[] CaseTypeOptions =
    [
        ("customer-complaint", "شكوى عميل"),
        ("operational-incident", "حادث تشغيلي"),
        ("internal-service-request", "طلب خدمة داخلي"),
        ("access-request", "طلب صلاحية"),
        ("compliance-case", "حالة امتثال"),
        ("technical-escalation", "تصعيد تقني"),
        ("operational-exception", "استثناء تشغيلي")
    ];

    private static readonly (string Value, string Label)[] PriorityOptions =
    [
        ("low", "منخفضة"),
        ("medium", "متوسطة"),
        ("high", "عالية"),
        ("critical", "حرجة")
    ];

    private static readonly (string Value, string Label)[] StatusOptions =
    [
        ("new", "جديدة"),
        ("assigned", "مسندة"),
        ("in-progress", "قيد المعالجة"),
        ("resolved", "محلولة"),
        ("closed", "مغلقة")
    ];

    private static readonly (string Value, string Label)[] SlaOptions =
    [
        ("not-applicable", "غير مطبق"),
        ("active", "نشط"),
        ("met", "محقق"),
        ("breached", "مخترق")
    ];

    private readonly List<DepartmentDto> _departments = [];
    private CaseSearchResponseDto? _response;
    private bool _loading;
    private string? _error;
    private string? _query;
    private string? _caseType;
    private string? _priority;
    private string? _status;
    private string? _slaState;
    private Guid? _departmentId;
    private DateTime? _createdFromDate;
    private DateTime? _createdToDate;
    private int _offset;
    private int _limit = 25;

    private bool HasNextPage =>
        _response is not null && _offset + _response.Items.Count < _response.Total;

    protected override async Task OnInitializedAsync()
    {
        var departments = await ApiClient.ListDepartmentsAsync();
        if (departments.IsSuccess && departments.Value is not null)
            _departments.AddRange(departments.Value);

        await SearchAsync();
    }

    private async Task SearchFromStartAsync()
    {
        _offset = 0;
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        if (_loading)
            return;

        _loading = true;
        _error = null;
        try
        {
            var result = await SearchClient.SearchAsync(new CaseSearchRequest(
                _query,
                _caseType,
                _priority,
                _status,
                _slaState,
                _departmentId,
                null,
                ToUtcStart(_createdFromDate),
                ToUtcEnd(_createdToDate),
                _offset,
                _limit));

            if (result.IsFailure || result.Value is null)
            {
                _response = null;
                _error = result.Error ?? "تعذر تنفيذ البحث التشغيلي.";
                return;
            }

            _response = result.Value;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ResetAsync()
    {
        _query = null;
        _caseType = null;
        _priority = null;
        _status = null;
        _slaState = null;
        _departmentId = null;
        _createdFromDate = null;
        _createdToDate = null;
        _offset = 0;
        _limit = 25;
        await SearchAsync();
    }

    private async Task PreviousPageAsync()
    {
        _offset = Math.Max(0, _offset - _limit);
        await SearchAsync();
    }

    private async Task NextPageAsync()
    {
        if (!HasNextPage)
            return;

        _offset += _limit;
        await SearchAsync();
    }

    private int DisplayRangeStart() =>
        _response is null || _response.Total == 0 ? 0 : _offset + 1;

    private int DisplayRangeEnd() =>
        _response is null ? 0 : Math.Min(_offset + _response.Items.Count, _response.Total);

    private static DateTimeOffset? ToUtcStart(DateTime? value) =>
        value.HasValue
            ? new DateTimeOffset(DateTime.SpecifyKind(value.Value.Date, DateTimeKind.Utc))
            : null;

    private static DateTimeOffset? ToUtcEnd(DateTime? value) =>
        value.HasValue
            ? new DateTimeOffset(
                DateTime.SpecifyKind(value.Value.Date.AddDays(1).AddTicks(-1), DateTimeKind.Utc))
            : null;

    private static string DisplayCaseType(string value) => value switch
    {
        "customer-complaint" => "شكوى عميل",
        "operational-incident" => "حادث تشغيلي",
        "internal-service-request" => "طلب خدمة داخلي",
        "access-request" => "طلب صلاحية",
        "compliance-case" => "حالة امتثال",
        "technical-escalation" => "تصعيد تقني",
        "operational-exception" => "استثناء تشغيلي",
        _ => value
    };

    private static string DisplayPriority(string value) => value switch
    {
        "low" => "منخفضة",
        "medium" => "متوسطة",
        "high" => "عالية",
        "critical" => "حرجة",
        _ => value
    };

    private static string DisplayStatus(string value) => value switch
    {
        "new" => "جديدة",
        "assigned" => "مسندة",
        "in-progress" => "قيد المعالجة",
        "resolved" => "محلولة",
        "closed" => "مغلقة",
        _ => value
    };

    private static string DisplaySlaState(string value) => value switch
    {
        "not-applicable" => "غير مطبق",
        "active" => "نشط",
        "met" => "محقق",
        "breached" => "مخترق",
        _ => value
    };
}
