@page "/login"
@attribute [AllowAnonymous]
@inject MadarApiClient ApiClient
@inject MadarAuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation

<PageTitle>تسجيل الدخول | مدار</PageTitle>

<MudGrid Justify="Justify.Center" Class="mt-8">
    <MudItem xs="12" sm="8" md="5">
        <MudPaper Elevation="0" Outlined="true" Class="pa-8" dir="rtl">
            <MudText Typo="Typo.h4" GutterBottom="true">تسجيل الدخول إلى مدار</MudText>
            <MudText Typo="Typo.body1" Class="mb-6">
                استخدم حسابك التشغيلي للوصول إلى الحالات والمهام المسندة إليك.
            </MudText>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
            }

            <form @onsubmit="LoginAsync" @onsubmit:preventDefault>
                <MudTextField T="string"
                              Label="البريد الإلكتروني"
                              InputType="InputType.Email"
                              Variant="Variant.Outlined"
                              @bind-Value="_email"
                              Disabled="_busy"
                              Class="mb-4" />
                <MudTextField T="string"
                              Label="كلمة المرور"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              @bind-Value="_password"
                              Disabled="_busy"
                              Class="mb-2" />
                <MudCheckBox T="bool"
                             Label="تذكرني"
                             @bind-Value="_rememberMe"
                             Disabled="_busy" />

                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           ButtonType="ButtonType.Submit"
                           FullWidth="true"
                           Disabled="_busy"
                           Class="mt-5">
                    @(_busy ? "جارٍ تسجيل الدخول..." : "تسجيل الدخول")
                </MudButton>
            </form>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _error;
    private bool _rememberMe;
    private bool _busy;

    private async Task LoginAsync()
    {
        if (_busy)
            return;

        _error = null;
        if (string.IsNullOrWhiteSpace(_email)
            || string.IsNullOrWhiteSpace(_password))
        {
            _error = "أدخل البريد الإلكتروني وكلمة المرور.";
            return;
        }

        _busy = true;
        try
        {
            var result = await ApiClient.LoginAsync(new LoginRequest(
                _email,
                _password,
                _rememberMe));

            if (result.IsFailure)
            {
                _error = result.Error ?? "تعذر تسجيل الدخول.";
                return;
            }

            _password = string.Empty;
            AuthenticationState.Refresh();
            Navigation.NavigateTo("/cases");
        }
        finally
        {
            _busy = false;
        }
    }
}
