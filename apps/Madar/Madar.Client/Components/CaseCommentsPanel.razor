@inject MadarApiClient ApiClient

<MudPaper Elevation="0" Outlined="true" Class="pa-6">
    <MudText Typo="Typo.h5" GutterBottom="true">التعليقات والمتابعة</MudText>
    <MudText Typo="Typo.body2" Class="mb-4">
        التعليقات سجل تعاوني ملحق بالحالة. لا يدعم هذا الإصدار تعديل التعليقات أو حذفها.
    </MudText>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    }

    <MudTextField T="string"
                  Label="إضافة تعليق"
                  Lines="3"
                  Counter="2000"
                  MaxLength="2000"
                  Variant="Variant.Outlined"
                  @bind-Value="_body"
                  Disabled="_saving" />
    <MudButton Color="Color.Primary"
               Variant="Variant.Filled"
               Disabled="_saving || string.IsNullOrWhiteSpace(_body)"
               OnClick="AddAsync"
               Class="mt-3 mb-5">
        @(_saving ? "جارٍ الحفظ..." : "إضافة التعليق")
    </MudButton>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_comments.Count == 0)
    {
        <MudText Typo="Typo.body2">لا توجد تعليقات على هذه الحالة حتى الآن.</MudText>
    }
    else
    {
        <MudStack Spacing="2">
            @foreach (var comment in _comments)
            {
                <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.subtitle2">@comment.AuthorDisplayName</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.caption">
                            @comment.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                        </MudText>
                    </MudStack>
                    <MudText Typo="Typo.body1" Class="mt-2" Style="white-space: pre-wrap; overflow-wrap: anywhere;">
                        @comment.Body
                    </MudText>
                </MudPaper>
            }
        </MudStack>
    }
</MudPaper>

<CaseAttachmentsPanel CaseId="CaseId" />

@code {
    [Parameter]
    public Guid CaseId { get; set; }

    private readonly List<CaseCommentDto> _comments = [];
    private bool _loading = true;
    private bool _saving;
    private string _body = string.Empty;
    private string? _error;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await ApiClient.ListCaseCommentsAsync(CaseId);
            if (result.IsFailure || result.Value is null)
            {
                _error = result.Error ?? "تعذر تحميل تعليقات الحالة.";
                return;
            }

            _comments.Clear();
            _comments.AddRange(result.Value);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddAsync()
    {
        if (_saving)
            return;

        _saving = true;
        _error = null;
        try
        {
            var result = await ApiClient.AddCaseCommentAsync(
                CaseId,
                new AddCaseCommentRequest(_body));
            if (result.IsFailure || result.Value is null)
            {
                _error = result.Error ?? "تعذر إضافة التعليق.";
                return;
            }

            _body = string.Empty;
            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }
}
