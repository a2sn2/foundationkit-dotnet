@using Microsoft.AspNetCore.Components.Forms
@inject MadarApiClient ApiClient

<MudPaper Elevation="0" Outlined="true" Class="pa-6">
    <MudText Typo="Typo.h5" GutterBottom="true">المرفقات والمستندات</MudText>
    <MudText Typo="Typo.body2" Class="mb-4">
        يمكن إرفاق PDF أو PNG أو JPEG أو TXT بحد أقصى 10 ميجابايت. لا يدعم هذا الإصدار تعديل المرفقات أو حذفها.
    </MudText>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    }

    <InputFile OnChange="SelectFile"
               accept=".pdf,.png,.jpg,.jpeg,.txt,application/pdf,image/png,image/jpeg,text/plain"
               disabled="@_saving" />

    @if (_selectedFile is not null)
    {
        <MudText Typo="Typo.caption" Class="d-block mt-2">
            @_selectedFile.Name — @FormatSize(_selectedFile.Size)
        </MudText>
    }

    <MudButton Color="Color.Primary"
               Variant="Variant.Filled"
               Disabled="_saving || _selectedFile is null"
               OnClick="UploadAsync"
               Class="mt-3 mb-5">
        @(_saving ? "جارٍ الرفع..." : "رفع المرفق")
    </MudButton>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_attachments.Count == 0)
    {
        <MudText Typo="Typo.body2">لا توجد مرفقات على هذه الحالة حتى الآن.</MudText>
    }
    else
    {
        <MudTable Items="_attachments" Dense="true" Elevation="0">
            <HeaderContent>
                <MudTh>الملف</MudTh>
                <MudTh>النوع</MudTh>
                <MudTh>الحجم</MudTh>
                <MudTh>رفع بواسطة</MudTh>
                <MudTh>الوقت</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate Context="attachment">
                <MudTd>@attachment.OriginalFileName</MudTd>
                <MudTd>@attachment.ContentType</MudTd>
                <MudTd>@FormatSize(attachment.SizeBytes)</MudTd>
                <MudTd>@attachment.UploadedByDisplayName</MudTd>
                <MudTd>@attachment.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
                <MudTd>
                    <MudButton Href="@CaseAttachmentRoutes.Download(CaseId, attachment.Id)"
                               Target="_blank"
                               Variant="Variant.Text"
                               Size="Size.Small">
                        تنزيل
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private const long MaxUploadBytes = 10L * 1024 * 1024;

    [Parameter]
    public Guid CaseId { get; set; }

    private readonly List<CaseAttachmentDto> _attachments = [];
    private IBrowserFile? _selectedFile;
    private bool _loading = true;
    private bool _saving;
    private string? _error;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private void SelectFile(InputFileChangeEventArgs args)
    {
        _error = null;
        var file = args.File;
        if (file.Size is < 1 or > MaxUploadBytes)
        {
            _selectedFile = null;
            _error = "حجم الملف يجب أن يكون أكبر من صفر وألا يتجاوز 10 ميجابايت.";
            return;
        }

        _selectedFile = file;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await ApiClient.ListCaseAttachmentsAsync(CaseId);
            if (result.IsFailure || result.Value is null)
            {
                _error = result.Error ?? "تعذر تحميل مرفقات الحالة.";
                return;
            }

            _attachments.Clear();
            _attachments.AddRange(result.Value);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task UploadAsync()
    {
        if (_saving || _selectedFile is null)
            return;

        _saving = true;
        _error = null;
        try
        {
            await using var stream = _selectedFile.OpenReadStream(MaxUploadBytes);
            var result = await ApiClient.UploadCaseAttachmentAsync(
                CaseId,
                stream,
                _selectedFile.Name,
                _selectedFile.ContentType,
                _selectedFile.Size);
            if (result.IsFailure || result.Value is null)
            {
                _error = result.Error ?? "تعذر رفع المرفق.";
                return;
            }

            _selectedFile = null;
            await LoadAsync();
        }
        catch (IOException)
        {
            _error = "تعذر قراءة الملف المحدد.";
        }
        finally
        {
            _saving = false;
        }
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";

        if (bytes < 1024 * 1024)
            return $"{bytes / 1024d:0.0} KB";

        return $"{bytes / (1024d * 1024d):0.0} MB";
    }
}
