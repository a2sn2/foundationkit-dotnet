@page "/"
@inject WorkbenchApiClient Api

<PageTitle>FoundationKit Core Studio</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-8">
    <section class="hero-grid">
        <div>
            <div class="eyebrow">FOUNDATIONKIT · SOFT ORBIT</div>
            <MudText Typo="Typo.h2" Class="hero-title">@T("من الـManifest إلى SQL وOpenAPI والواجهة — بعقد واحد وهوية واحدة.", "From Manifest to SQL, OpenAPI and UI — one contract, one visual language.")</MudText>
            <MudText Typo="Typo.h6" Class="hero-copy">
                @T(
                    "Core Studio هو المرجع الحي للكور ونظام التصميم معًا: القدرات، تركيب الموديولات، عقود الـAPI، محرك القراءة SQL-first، والـRead Models والـGenerated Apps كلها تتحرك فوق نفس FoundationKit.Blazor tokens والمكونات.",
                    "Core Studio is the living reference for both the Core and the design system: capabilities, module composition, API contracts, SQL-first reads, Read Models and Generated Apps all share the same FoundationKit.Blazor tokens and components.")
            </MudText>
            <div class="fk-row fk-wrap" style="margin-top:var(--fk-space-6)">
                <FkButton Href="compose">@T("ابدأ من Composer", "Start with Composer")</FkButton>
                <FkButton Variant="FoundationButtonVariant.Secondary" Href="design">@T("افتح نظام التصميم", "Open Design System")</FkButton>
                <FkButton Variant="FoundationButtonVariant.Ghost" Href="evidence">@T("أدلة التنفيذ", "Engineering evidence")</FkButton>
            </div>
        </div>

        <div class="core-orbit" aria-hidden="true">
            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>
            <div class="core-node">FK</div>
            <span class="satellite satellite-api">OPENAPI</span>
            <span class="satellite satellite-ui">UI</span>
            <span class="satellite satellite-db">SQL</span>
        </div>
    </section>

    @if (_loading)
    {
        <FkLoadingState Title="@T("نقرأ حالة الكور", "Reading Core state")"
                        Description="Catalog → Modules → SQL health → design baseline" />
    }
    else
    {
        <div class="fk-row fk-wrap" style="margin-top:var(--fk-space-5)">
            <FkBadge Tone="@RuntimeTone">@RuntimeLabel</FkBadge>
            <FkBadge Tone="@HealthTone">@HealthLabel</FkBadge>
            <span class="fk-muted">@RuntimeDescription</span>
        </div>

        <section class="section-block">
            <div class="section-heading">
                <div>
                    <div class="eyebrow">CURRENT CORE BASELINE</div>
                    <MudText Typo="Typo.h3">@T("صورة واحدة للحالة التي يثبتها المستودع", "One view of the state proved by the repository")</MudText>
                </div>
                <MudText Class="muted-text">@T("الواجهة تعرض أدلة الكور؛ لا تمنح صلاحيات ولا تستبدل تحقق السيرفر.", "The UI surfaces Core evidence; it grants no authorization and never replaces server validation.")</MudText>
            </div>

            <MudGrid>
                <MudItem xs="12" sm="6" lg="3">
                    <MudPaper Class="metric-card" Elevation="0">
                        <MudText Typo="Typo.overline">REUSABLE PACKAGES</MudText>
                        <MudText Typo="Typo.h2">@PackageCount</MudText>
                        <MudText Class="muted-text">@T("حزمة Core قابلة لإعادة الاستخدام، بدون إنشاء package #18 للواجهة.", "Reusable Core packages, with no package #18 created for the UI.")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" lg="3">
                    <MudPaper Class="metric-card" Elevation="0">
                        <MudText Typo="Typo.overline">CAPABILITIES</MudText>
                        <MudText Typo="Typo.h2">@CapabilityCount</MudText>
                        <MudText Class="muted-text">@T("قدرات منشورة في الكتالوج مع حالة ومداخل عامة قابلة للفحص.", "Catalog capabilities with inspectable status and public entry points.")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" lg="3">
                    <MudPaper Class="metric-card" Elevation="0">
                        <MudText Typo="Typo.overline">LIVE MODULES</MudText>
                        <MudText Typo="Typo.h2">@ModuleCount</MudText>
                        <MudText Class="muted-text">@T("تركيب declared/effective من الـModule Engine الجاري فعليًا.", "Declared/effective composition from the running Module Engine.")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" lg="3">
                    <MudPaper Class="metric-card" Elevation="0">
                        <MudText Typo="Typo.overline">VISUAL DNA</MudText>
                        <MudText Typo="Typo.h2">1</MudText>
                        <MudText Class="muted-text">@T("Core Studio والأمثلة والمشاريع المولدة تشترك في نفس Soft Orbit baseline.", "Core Studio, samples and generated products share the same Soft Orbit baseline.")</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </section>

        <section class="section-block">
            <div class="section-heading">
                <div>
                    <div class="eyebrow">FULL CONTRACT FLOW</div>
                    <MudText Typo="Typo.h3">@T("المسار الذي يجب أن يظل قابلًا للتتبع", "The chain that must remain traceable")</MudText>
                </div>
            </div>

            <div class="contract-flow" aria-label="FoundationKit contract flow">
                @foreach (var step in ContractFlow)
                {
                    <div class="contract-step">
                        <span>@step.Number</span>
                        <strong>@step.Title</strong>
                        <small>@T(step.DescriptionAr, step.DescriptionEn)</small>
                    </div>
                }
            </div>
        </section>

        <section class="section-block">
            <div class="section-heading">
                <div>
                    <div class="eyebrow">PHASE 12 CLOSURE</div>
                    <MudText Typo="Typo.h3">@T("المسارات التي ثبّتت الأساس قبل أول مشروع", "Closure tracks that stabilized the foundation before the first product")</MudText>
                </div>
                <FkButton Variant="FoundationButtonVariant.Secondary" Href="design">@T("راجع المكونات الحقيقية", "Inspect real components")</FkButton>
            </div>

            <MudGrid>
                @foreach (var track in ClosureTracks)
                {
                    <MudItem xs="12" md="6" lg="3">
                        <MudPaper Class="architecture-card" Elevation="0">
                            <FkBadge Tone="FoundationBadgeTone.Success">@track.Id</FkBadge>
                            <MudText Typo="Typo.h6">@track.Title</MudText>
                            <MudText Class="muted-text">@T(track.DescriptionAr, track.DescriptionEn)</MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </section>
    }
</MudContainer>

@code {
    [CascadingParameter(Name = "FoundationLanguage")]
    private string Language { get; set; } = "ar";

    private RuntimeResponse? _runtime;
    private HealthResponse? _health;
    private CatalogResponse? _catalog;
    private IReadOnlyList<ModuleCompositionResponse> _modules = Array.Empty<ModuleCompositionResponse>();
    private bool _loading = true;

    private bool IsArabic => string.Equals(Language, "ar", StringComparison.OrdinalIgnoreCase);
    private string T(string ar, string en) => IsArabic ? ar : en;

    private int PackageCount => _catalog?.Packages.Count ?? 17;
    private int CapabilityCount => _catalog?.Packages.SelectMany(package => package.Capabilities).Select(item => item.Id).Distinct(StringComparer.OrdinalIgnoreCase).Count() ?? 0;
    private int ModuleCount => _modules.Count;
    private FoundationBadgeTone RuntimeTone => _runtime?.Mode == "local" ? FoundationBadgeTone.Success : FoundationBadgeTone.Warning;
    private FoundationBadgeTone HealthTone => string.Equals(_health?.Status, "healthy", StringComparison.OrdinalIgnoreCase) ? FoundationBadgeTone.Success : FoundationBadgeTone.Warning;
    private string RuntimeLabel => _runtime?.Mode == "local" ? "LIVE WORKBENCH" : "STATIC CATALOG MODE";
    private string HealthLabel => string.Equals(_health?.Status, "healthy", StringComparison.OrdinalIgnoreCase) ? "SQL HEALTHY" : "SQL NOT VERIFIED";
    private string RuntimeDescription => _runtime?.Mode == "local"
        ? T("Workbench API وSQL Server متاحان، ويمكن قراءة الأدلة الحية.", "Workbench API and SQL Server are available; live evidence can be read.")
        : T("الواجهة تستطيع عرض الكتالوج الثابت، لكن الأدلة الحية تحتاج Workbench API.", "The UI can show the static catalog, but live evidence requires the Workbench API.");

    private static readonly IReadOnlyList<FlowStep> ContractFlow =
    [
        new("01", "Composer v2", "Project → Modules → Resources / Read Models", "Project → Modules → Resources / Read Models"),
        new("02", "Generated Backend", "Entities، policies، migrations، SQL views", "Entities, policies, migrations and SQL views"),
        new("03", "Runtime OpenAPI", "العقد المتسلسل canonical للـtransport", "Canonical serialized transport contract"),
        new("04", "Typed Client", "عميل C# حتمي مع metadata وETag", "Deterministic C# client with metadata and ETag"),
        new("05", "Shared UI", "FoundationKit.Blazor tokens/components؛ authorization يبقى على السيرفر", "FoundationKit.Blazor tokens/components; authorization stays on the server")
    ];

    private static readonly IReadOnlyList<ClosureTrackCard> ClosureTracks =
    [
        new("12.C1", "Typed Transport", "OpenAPI → عميل C# حتمي مع ETag/Location/Correlation metadata.", "OpenAPI → deterministic C# client with ETag/Location/Correlation metadata."),
        new("12.C2", "SQL Read Engine", "filter/sort/page داخل SQL + indexed fields + view-backed multi-table/report reads.", "SQL-side filter/sort/page + indexed fields + view-backed multi-table/report reads."),
        new("12.C3", "Frontend Foundation", "حالة عرض قابلة لإعادة الاستخدام + Core Studio دون business logic في المتصفح.", "Reusable presentation state + Core Studio without browser-side business logic."),
        new("12.C4", "Tooling Closure", "تحقق Visual Composer canonical + توليد Blazor حتمي موصول بـOpenAPI.", "Canonical Visual Composer validation + deterministic OpenAPI-wired Blazor generation.")
    ];

    protected override async Task OnInitializedAsync()
    {
        var runtime = await Api.GetRuntimeAsync();
        _runtime = runtime.IsSuccess ? runtime.Value : null;

        var health = await Api.GetHealthAsync();
        _health = health.IsSuccess ? health.Value : null;

        var catalog = await Api.GetCatalogAsync();
        _catalog = catalog.IsSuccess ? catalog.Value : null;

        var modules = await Api.GetModulesAsync();
        _modules = modules.IsSuccess && modules.Value is not null
            ? modules.Value
            : Array.Empty<ModuleCompositionResponse>();

        _loading = false;
    }

    private sealed record FlowStep(string Number, string Title, string DescriptionAr, string DescriptionEn);
    private sealed record ClosureTrackCard(string Id, string Title, string DescriptionAr, string DescriptionEn);
}
