@page "/"
@inject WorkbenchApiClient Api

<PageTitle>FoundationKit Core Studio</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-8">
    <section class="hero-grid">
        <div>
            <div class="eyebrow">FOUNDATIONKIT CORE STUDIO</div>
            <MudText Typo="Typo.h2" Class="hero-title">من الـManifest إلى SQL وOpenAPI والـTyped Client — بعقد واحد يمكن إثباته.</MudText>
            <MudText Typo="Typo.h6" Class="hero-copy">
                هذه الواجهة مرجع للكور نفسه: القدرات، تركيب الموديولات، عقود الـAPI، محرك القراءة SQL‑first،
                والـRead Models المبنية على Views. التصميم البصري النهائي سيُثبت لاحقًا بشكل موحد للكور وللمشاريع المولدة.
            </MudText>
            <MudStack Row="true" Spacing="2" Class="mt-6 flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="studio" StartIcon="@Icons.Material.Filled.AccountTree">
                    افتح Core Studio
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="evidence" StartIcon="@Icons.Material.Filled.FactCheck">
                    أدلة التنفيذ
                </MudButton>
                <MudButton Variant="Variant.Text" Href="swagger" Target="_blank" StartIcon="@Icons.Material.Filled.Api">
                    Runtime OpenAPI
                </MudButton>
            </MudStack>
        </div>

        <div class="core-orbit" aria-hidden="true">
            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>
            <div class="core-node">FK</div>
            <span class="satellite satellite-api">OPENAPI</span>
            <span class="satellite satellite-ui">CLIENT</span>
            <span class="satellite satellite-db">SQL</span>
        </div>
    </section>

    @if (_loading)
    {
        <div class="loading-panel" role="status" aria-live="polite">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <MudText>جاري قراءة حالة الكور والكتالوج والموديولات...</MudText>
        </div>
    }
    else
    {
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-4 flex-wrap">
            <MudChip T="string" Color="@RuntimeColor" Variant="Variant.Outlined">@RuntimeLabel</MudChip>
            <MudChip T="string" Color="@HealthColor" Variant="Variant.Outlined">@HealthLabel</MudChip>
            <MudText Class="muted-text">@RuntimeDescription</MudText>
        </MudStack>

        <section class="section-block">
            <div class="section-heading">
                <div>
                    <div class="eyebrow">CURRENT CORE BASELINE</div>
                    <MudText Typo="Typo.h3">صورة واحدة للحالة التي يثبتها المستودع</MudText>
                </div>
                <MudText Class="muted-text">الواجهة تعرض أدلة الكور؛ لا تمنح صلاحيات ولا تستبدل تحقق السيرفر.</MudText>
            </div>

            <MudGrid>
                <MudItem xs="12" sm="6" lg="3">
                    <MudPaper Class="metric-card" Elevation="0">
                        <MudText Typo="Typo.overline">REUSABLE PACKAGES</MudText>
                        <MudText Typo="Typo.h2">@PackageCount</MudText>
                        <MudText Class="muted-text">حزمة Core قابلة لإعادة الاستخدام، بدون إنشاء package #18 لمجرد الواجهة.</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" lg="3">
                    <MudPaper Class="metric-card" Elevation="0">
                        <MudText Typo="Typo.overline">CAPABILITIES</MudText>
                        <MudText Typo="Typo.h2">@CapabilityCount</MudText>
                        <MudText Class="muted-text">قدرات منشورة في الكتالوج مع حالة ومداخل عامة قابلة للفحص.</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" lg="3">
                    <MudPaper Class="metric-card" Elevation="0">
                        <MudText Typo="Typo.overline">LIVE MODULES</MudText>
                        <MudText Typo="Typo.h2">@ModuleCount</MudText>
                        <MudText Class="muted-text">تركيب declared/effective من الـModule Engine الجاري فعليًا.</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" lg="3">
                    <MudPaper Class="metric-card" Elevation="0">
                        <MudText Typo="Typo.overline">CONTRACT CHAIN</MudText>
                        <MudText Typo="Typo.h2">1</MudText>
                        <MudText Class="muted-text">Backend → OpenAPI → Postman/Typed Client → UI، بدون مصدر حقيقة ثانٍ.</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </section>

        <section class="section-block">
            <div class="section-heading">
                <div>
                    <div class="eyebrow">FULL CONTRACT FLOW</div>
                    <MudText Typo="Typo.h3">المسار الذي يجب أن يظل قابلًا للتتبع</MudText>
                </div>
            </div>

            <div class="contract-flow" aria-label="FoundationKit contract flow">
                @foreach (var step in ContractFlow)
                {
                    <div class="contract-step">
                        <span>@step.Number</span>
                        <strong>@step.Title</strong>
                        <small>@step.Description</small>
                    </div>
                }
            </div>
        </section>

        <section class="section-block">
            <div class="section-heading">
                <div>
                    <div class="eyebrow">PHASE 12 CLOSURE</div>
                    <MudText Typo="Typo.h3">مسارات الإغلاق التي ثبّتت الأساس قبل التصميم النهائي</MudText>
                </div>
            </div>

            <MudGrid>
                @foreach (var track in ClosureTracks)
                {
                    <MudItem xs="12" md="6" lg="3">
                        <MudPaper Class="architecture-card" Elevation="0">
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined">@track.Id</MudChip>
                            <MudText Typo="Typo.h6">@track.Title</MudText>
                            <MudText Class="muted-text">@track.Description</MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </section>
    }
</MudContainer>

@code {
    private RuntimeResponse? _runtime;
    private HealthResponse? _health;
    private CatalogResponse? _catalog;
    private IReadOnlyList<ModuleCompositionResponse> _modules = Array.Empty<ModuleCompositionResponse>();
    private bool _loading = true;

    private int PackageCount => _catalog?.Packages.Count ?? 17;
    private int CapabilityCount => _catalog?.Packages.SelectMany(package => package.Capabilities).Select(item => item.Id).Distinct(StringComparer.OrdinalIgnoreCase).Count() ?? 0;
    private int ModuleCount => _modules.Count;
    private Color RuntimeColor => _runtime?.Mode == "local" ? Color.Success : Color.Warning;
    private Color HealthColor => string.Equals(_health?.Status, "healthy", StringComparison.OrdinalIgnoreCase) ? Color.Success : Color.Warning;
    private string RuntimeLabel => _runtime?.Mode == "local" ? "LIVE WORKBENCH" : "STATIC CATALOG MODE";
    private string HealthLabel => string.Equals(_health?.Status, "healthy", StringComparison.OrdinalIgnoreCase) ? "SQL HEALTHY" : "SQL NOT VERIFIED";
    private string RuntimeDescription => _runtime?.Mode == "local"
        ? "Workbench API وSQL Server متاحان، ويمكن قراءة الأدلة الحية."
        : "الواجهة تستطيع عرض الكتالوج الثابت، لكن الأدلة الحية تحتاج Workbench API.";

    private static readonly IReadOnlyList<FlowStep> ContractFlow =
    [
        new("01", "Composer v2", "Project → Modules → Resources/Read Models"),
        new("02", "Generated Backend", "Entities, policies, migrations, SQL views"),
        new("03", "Runtime OpenAPI", "العقد المتسلسل canonical للـtransport"),
        new("04", "Typed Client", "C# deterministic client مع metadata وETag"),
        new("05", "Core UI", "Presentation فقط؛ authorization يبقى على السيرفر")
    ];

    private static readonly IReadOnlyList<ClosureTrackCard> ClosureTracks =
    [
        new("12.C1", "Typed Transport", "OpenAPI → deterministic C# client مع ETag/Location/Correlation metadata."),
        new("12.C2", "SQL Read Engine", "SQL-side filter/sort/page + indexed fields + view-backed multi-table/report reads."),
        new("12.C3", "Frontend Foundation", "Reusable presentation state + Core Studio reference experience دون business logic في المتصفح."),
        new("12.C4", "Tooling Closure", "Canonical visual Composer validation + deterministic OpenAPI-wired Blazor shell generation.")
    ];

    protected override async Task OnInitializedAsync()
    {
        var runtime = await Api.GetRuntimeAsync();
        _runtime = runtime.IsSuccess ? runtime.Value : null;

        var health = await Api.GetHealthAsync();
        _health = health.IsSuccess ? health.Value : null;

        var catalog = await Api.GetCatalogAsync();
        _catalog = catalog.IsSuccess ? catalog.Value : null;

        var modules = await Api.GetModulesAsync();
        _modules = modules.IsSuccess && modules.Value is not null
            ? modules.Value
            : Array.Empty<ModuleCompositionResponse>();

        _loading = false;
    }

    private sealed record FlowStep(string Number, string Title, string Description);
    private sealed record ClosureTrackCard(string Id, string Title, string Description);
}
