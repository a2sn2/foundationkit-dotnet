@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<FkAppShell Direction="rtl"
            NavigationLabel="التنقل في Core Studio"
            DarkModeLabel="التبديل إلى الوضع الداكن"
            LightModeLabel="التبديل إلى الوضع الفاتح"
            Class="workbench-shell">
    <Brand>
        <FkBrandMark Name="FoundationKit"
                     Tagline="Core Studio · Soft Orbit"
                     Href="/"
                     AriaLabel="FoundationKit Core Studio" />
    </Brand>
    <Navigation>
        <FkNavItem Href="/" Match="NavLinkMatch.All">
            <Icon><MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" /></Icon>
            <ChildContent>الرئيسية</ChildContent>
        </FkNavItem>
        <FkNavItem Href="studio">
            <Icon><MudIcon Icon="@Icons.Material.Filled.Hub" Size="Size.Small" /></Icon>
            <ChildContent>Studio</ChildContent>
        </FkNavItem>
        <FkNavItem Href="compose">
            <Icon><MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" /></Icon>
            <ChildContent>Compose</ChildContent>
        </FkNavItem>
        <FkNavItem Href="design">
            <Icon><MudIcon Icon="@Icons.Material.Filled.Palette" Size="Size.Small" /></Icon>
            <ChildContent>Design</ChildContent>
        </FkNavItem>
        <FkNavItem Href="evidence">
            <Icon><MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Small" /></Icon>
            <ChildContent>Evidence</ChildContent>
        </FkNavItem>
    </Navigation>
    <TopbarStart>
        <button class="fk-command" type="button" title="Command Palette — foundation placeholder" aria-label="فتح البحث والأوامر">
            <span>ابحث أو نفّذ أمرًا</span>
            <kbd>Ctrl K</kbd>
        </button>
    </TopbarStart>
    <TopbarActions>
        <FkBadge Tone="FoundationBadgeTone.Aqua">Core v1</FkBadge>
        <FkButton Variant="FoundationButtonVariant.Secondary"
                  Size="FoundationButtonSize.Small"
                  Href="swagger"
                  Target="_blank">
            OpenAPI
        </FkButton>
    </TopbarActions>
    <ChildContent>
        @Body
    </ChildContent>
</FkAppShell>
