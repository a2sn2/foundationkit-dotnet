@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<FkAppShell Direction="auto"
            Language="@_language"
            LanguageChanged="SetLanguage"
            NavigationLabel="@T("التنقل في FoundationKit", "FoundationKit navigation")"
            DarkModeLabel="@T("التبديل إلى الوضع الداكن", "Switch to dark mode")"
            LightModeLabel="@T("التبديل إلى الوضع الفاتح", "Switch to light mode")"
            Class="workbench-shell">
    <Brand>
        <FkBrandMark Name="FoundationKit"
                     Tagline="Project Studio · Soft Orbit"
                     Href="/"
                     AriaLabel="FoundationKit Project Studio" />
    </Brand>
    <Navigation>
        <FkNavItem Href="/" Match="NavLinkMatch.All">
            <Icon><MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" /></Icon>
            <ChildContent>@T("الرئيسية", "Overview")</ChildContent>
        </FkNavItem>
        <FkNavItem Href="studio">
            <Icon><MudIcon Icon="@Icons.Material.Filled.AutoAwesomeMosaic" Size="Size.Small" /></Icon>
            <ChildContent>@T("استوديو المشاريع", "Project Studio")</ChildContent>
        </FkNavItem>
        <FkNavItem Href="compose">
            <Icon><MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" /></Icon>
            <ChildContent>@T("الكمبوزر المتقدم", "Advanced Composer")</ChildContent>
        </FkNavItem>
        <FkNavItem Href="design">
            <Icon><MudIcon Icon="@Icons.Material.Filled.Palette" Size="Size.Small" /></Icon>
            <ChildContent>@T("نظام التصميم", "Design")</ChildContent>
        </FkNavItem>
        <FkNavItem Href="evidence">
            <Icon><MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Small" /></Icon>
            <ChildContent>@T("الأدلة", "Evidence")</ChildContent>
        </FkNavItem>
    </Navigation>
    <TopbarStart>
        <button class="fk-command" type="button" title="Command Palette — foundation placeholder" aria-label="@T("فتح البحث والأوامر", "Open search and commands")">
            <span>@T("ابحث أو نفّذ أمرًا", "Search or run a command")</span>
            <kbd>Ctrl K</kbd>
        </button>
    </TopbarStart>
    <TopbarActions>
        <FkBadge Tone="FoundationBadgeTone.Aqua">Core v1</FkBadge>
        <FkButton Variant="FoundationButtonVariant.Secondary"
                  Size="FoundationButtonSize.Small"
                  Href="swagger"
                  Target="_blank">
            OpenAPI
        </FkButton>
    </TopbarActions>
    <ChildContent>
        <CascadingValue Value="@_language" Name="FoundationLanguage">
            @Body
        </CascadingValue>
    </ChildContent>
</FkAppShell>

@code {
    private string _language = "ar";

    private string T(string ar, string en) => _language == "ar" ? ar : en;

    private void SetLanguage(string language)
    {
        _language = string.Equals(language, "ar", StringComparison.OrdinalIgnoreCase) ? "ar" : "en";
    }
}