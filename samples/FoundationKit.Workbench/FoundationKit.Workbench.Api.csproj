<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>FoundationKit.Workbench</RootNamespace>
    <AssemblyName>FoundationKit.Workbench.Api</AssemblyName>
    <IsPackable>false</IsPackable>
    <UserSecretsId>FoundationKit.Workbench-Local</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FoundationKit.Domain\FoundationKit.Domain.csproj" />
    <ProjectReference Include="..\..\src\FoundationKit.Application\FoundationKit.Application.csproj" />
    <ProjectReference Include="..\..\src\FoundationKit.Infrastructure\FoundationKit.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\FoundationKit.WebApi\FoundationKit.WebApi.csproj" />
    <ProjectReference Include="..\..\src\FoundationKit.Auditing\FoundationKit.Auditing.csproj" />
    <ProjectReference Include="..\..\src\FoundationKit.Settings\FoundationKit.Settings.csproj" />
    <ProjectReference Include="..\..\src\FoundationKit.FeatureManagement\FoundationKit.FeatureManagement.csproj" />
    <ProjectReference Include="..\..\src\FoundationKit.Localization\FoundationKit.Localization.csproj" />
    <ProjectReference Include="..\..\src\FoundationKit.Caching\FoundationKit.Caching.csproj" />
    <ProjectReference Include="..\FoundationKit.Workbench.Contracts\FoundationKit.Workbench.Contracts.csproj" />
    <ProjectReference Include="..\FoundationKit.Workbench.Client\FoundationKit.Workbench.Client.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\catalog\foundationkit.catalog.json">
      <LogicalName>FoundationKit.Workbench.Catalog.foundationkit.catalog.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
