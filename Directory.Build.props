<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Security-quality baseline. These are repository controls, not a claim of external certification. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>

    <!--
      Deliberate package-API compatibility exceptions. FoundationKit already exposes
      these established public names/factory members. Renaming/removing them only to
      satisfy design-style rules would be a breaking change unrelated to security.
      Behavioral, reliability, globalization, disposal, and security analyzer rules
      remain warnings-as-errors.
    -->
    <NoWarn>$(NoWarn);CA1000;CA1711;CA1716</NoWarn>
  </PropertyGroup>
</Project>
