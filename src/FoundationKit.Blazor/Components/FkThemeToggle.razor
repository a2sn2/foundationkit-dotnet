@namespace FoundationKit.Blazor.Components
@inject IJSRuntime Js

<button type="button"
        class="fk-theme-toggle @Class"
        title="@Title"
        aria-label="@Title"
        @onclick="ToggleAsync">
    <span class="fk-theme-toggle__icon" aria-hidden="true"></span>
</button>

@code {
    [Parameter]
    public string LightLabel { get; set; } = "Switch to dark mode";

    [Parameter]
    public string DarkLabel { get; set; } = "Switch to light mode";

    [Parameter]
    public string? Class { get; set; }

    private bool _dark;
    private string Title => _dark ? DarkLabel : LightLabel;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var resolved = await Js.InvokeAsync<string>("FoundationKitTheme.currentResolved");
        _dark = string.Equals(resolved, "dark", StringComparison.Ordinal);
        StateHasChanged();
    }

    private async Task ToggleAsync()
    {
        var resolved = await Js.InvokeAsync<string>("FoundationKitTheme.toggle");
        _dark = string.Equals(resolved, "dark", StringComparison.Ordinal);
    }
}
