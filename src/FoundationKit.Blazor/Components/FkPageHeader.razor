@namespace FoundationKit.Blazor.Components

<header class="fk-page-header @Class">
    <div class="fk-page-header__copy">
        @if (!string.IsNullOrWhiteSpace(Eyebrow))
        {
            <span class="fk-page-header__eyebrow">@Eyebrow</span>
        }
        <h1>@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="fk-page-header__description">@Description</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="fk-page-header__actions">@Actions</div>
    }
</header>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? Eyebrow { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public string? Class { get; set; }
}
