@namespace FoundationKit.Blazor.Components

<div class="fk-shell @Class" dir="@NormalizedDirection" data-fk-shell-language="@NormalizedLanguage">
    <aside class="fk-shell__sidebar" aria-label="@NavigationLabel">
        @if (Brand is not null)
        {
            @Brand
        }
        else
        {
            <FkBrandMark Href="/" />
        }
        <nav class="fk-nav" aria-label="@NavigationLabel">
            @Navigation
        </nav>
        @if (SidebarFooter is not null)
        {
            <div style="margin-top:auto">@SidebarFooter</div>
        }
    </aside>

    <header class="fk-shell__topbar">
        @if (TopbarStart is not null)
        {
            @TopbarStart
        }
        <span class="fk-spacer"></span>
        @if (TopbarActions is not null)
        {
            @TopbarActions
        }
        @if (ShowLanguageToggle)
        {
            <FkLanguageToggle Language="@NormalizedLanguage"
                              LanguageChanged="@OnLanguageChangedAsync"
                              EnglishLabel="@EnglishLabel"
                              ArabicLabel="@ArabicLabel"
                              EnglishAriaLabel="@EnglishAriaLabel"
                              ArabicAriaLabel="@ArabicAriaLabel" />
        }
        <FkThemeToggle LightLabel="@DarkModeLabel" DarkLabel="@LightModeLabel" />
    </header>

    <main class="fk-shell__content">
        @ChildContent
    </main>
</div>

<style>
    /*
       The shell itself owns dir. CSS Grid already mirrors its explicit tracks when
       direction is RTL, so the generic ancestor RTL rules in the shared stylesheet
       would otherwise reverse the layout a second time. These same-element rules are
       intentionally colocated with the shell so every consumer, including generated
       apps, gets the correct physical sidebar placement without project-specific CSS.
    */
    .fk-shell[dir="rtl"] {
        grid-template-columns: var(--fk-sidebar-width) minmax(0, 1fr);
        grid-template-areas:
            "sidebar topbar"
            "sidebar content";
    }

    .fk-shell[dir="rtl"] .fk-shell__sidebar {
        border-inline-start: 0;
        border-inline-end: 1px solid var(--fk-border-default);
    }

    @@media (max-width: 68.75rem) {
        .fk-shell[dir="rtl"] {
            grid-template-columns: var(--fk-sidebar-compact) minmax(0, 1fr);
        }
    }

    @@media (max-width: 47.5rem) {
        .fk-shell[dir="rtl"] {
            display: block;
        }
    }
</style>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Brand { get; set; }

    [Parameter]
    public RenderFragment? Navigation { get; set; }

    [Parameter]
    public RenderFragment? SidebarFooter { get; set; }

    [Parameter]
    public RenderFragment? TopbarStart { get; set; }

    [Parameter]
    public RenderFragment? TopbarActions { get; set; }

    [Parameter]
    public string Direction { get; set; } = "ltr";

    [Parameter]
    public string Language { get; set; } = "en";

    [Parameter]
    public EventCallback<string> LanguageChanged { get; set; }

    [Parameter]
    public bool ShowLanguageToggle { get; set; } = true;

    [Parameter]
    public string EnglishLabel { get; set; } = "EN";

    [Parameter]
    public string ArabicLabel { get; set; } = "ع";

    [Parameter]
    public string EnglishAriaLabel { get; set; } = "Switch to English";

    [Parameter]
    public string ArabicAriaLabel { get; set; } = "التبديل إلى العربية";

    [Parameter]
    public string NavigationLabel { get; set; } = "Application navigation";

    [Parameter]
    public string DarkModeLabel { get; set; } = "Switch to dark mode";

    [Parameter]
    public string LightModeLabel { get; set; } = "Switch to light mode";

    [Parameter]
    public string? Class { get; set; }

    private string NormalizedLanguage => string.Equals(Language, "ar", StringComparison.OrdinalIgnoreCase) ? "ar" : "en";
    private string NormalizedDirection => string.Equals(Direction, "auto", StringComparison.OrdinalIgnoreCase)
        ? (NormalizedLanguage == "ar" ? "rtl" : "ltr")
        : string.Equals(Direction, "rtl", StringComparison.OrdinalIgnoreCase) ? "rtl" : "ltr";

    private Task OnLanguageChangedAsync(string language) => LanguageChanged.InvokeAsync(language);
}
