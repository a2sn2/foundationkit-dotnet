@namespace FoundationKit.Blazor.Components
@inject IJSRuntime Js

<button type="button"
        class="fk-button fk-button--secondary fk-button--small fk-language-toggle @Class"
        title="@TargetTitle"
        aria-label="@TargetTitle"
        data-fk-language-toggle
        @onclick="ToggleAsync">
    <span aria-hidden="true">@TargetLabel</span>
</button>

@code {
    [Parameter]
    public string Language { get; set; } = "en";

    [Parameter]
    public EventCallback<string> LanguageChanged { get; set; }

    [Parameter]
    public string EnglishLabel { get; set; } = "EN";

    [Parameter]
    public string ArabicLabel { get; set; } = "ع";

    [Parameter]
    public string EnglishAriaLabel { get; set; } = "Switch to English";

    [Parameter]
    public string ArabicAriaLabel { get; set; } = "التبديل إلى العربية";

    [Parameter]
    public string? Class { get; set; }

    private string _language = "en";
    private string TargetLabel => _language == "ar" ? EnglishLabel : ArabicLabel;
    private string TargetTitle => _language == "ar" ? EnglishAriaLabel : ArabicAriaLabel;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var initialized = await Js.InvokeAsync<string>("FoundationKitLocale.initialize", Normalize(Language));
        _language = Normalize(initialized);
        if (!string.Equals(_language, Normalize(Language), StringComparison.Ordinal))
            await LanguageChanged.InvokeAsync(_language);
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        _language = Normalize(Language);
    }

    private async Task ToggleAsync()
    {
        var next = _language == "ar" ? "en" : "ar";
        _language = Normalize(await Js.InvokeAsync<string>("FoundationKitLocale.set", next));
        await LanguageChanged.InvokeAsync(_language);
    }

    private static string Normalize(string? language) =>
        string.Equals(language, "ar", StringComparison.OrdinalIgnoreCase) ? "ar" : "en";
}
