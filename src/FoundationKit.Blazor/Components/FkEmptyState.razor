@namespace FoundationKit.Blazor.Components

<section class="fk-empty @Class" role="status">
    <div class="fk-empty__visual" aria-hidden="true">
        <span class="fk-orbit-path fk-orbit-path--one"></span>
        <span class="fk-orbit-path fk-orbit-path--two"></span>
        <span class="fk-orbit-node"></span>
        <span class="fk-orbit-node fk-orbit-node--aqua"></span>
        <span class="fk-orbit-node fk-orbit-node--warm"></span>
    </div>
    <h2>@Title</h2>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p>@Description</p>
    }
    @if (Action is not null)
    {
        <div class="fk-row fk-wrap">@Action</div>
    }
</section>

@code {
    [Parameter]
    public string Title { get; set; } = "Nothing here yet";

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? Action { get; set; }

    [Parameter]
    public string? Class { get; set; }
}
