{
  "openapi": "3.0.1",
  "info": {
    "title": "FoundationKit Frontend Generation Fixture",
    "version": "v1"
  },
  "paths": {
    "/api/widgets": {
      "get": {
        "x-foundation-module": "Widget",
        "x-foundation-operation": "list",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32" }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WidgetResponsePagedResult" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "WidgetResponse": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" }
        }
      },
      "WidgetResponsePagedResult": {
        "type": "object",
        "required": ["items", "page", "pageSize", "totalCount", "totalPages", "hasPreviousPage", "hasNextPage"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/WidgetResponse" }
          },
          "page": { "type": "integer", "format": "int32" },
          "pageSize": { "type": "integer", "format": "int32" },
          "totalCount": { "type": "integer", "format": "int32" },
          "totalPages": { "type": "integer", "format": "int32" },
          "hasPreviousPage": { "type": "boolean" },
          "hasNextPage": { "type": "boolean" }
        }
      }
    }
  }
}
