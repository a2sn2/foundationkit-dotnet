{
  "info": {
    "_postman_id": "4f6c2d31-93ec-4d6e-b247-2f6ecb359b11",
    "name": "FoundationKit Workbench API",
    "description": "Executable Core reference requests. The Core CRUD folder mirrors the same request/response contracts used by the generic Workbench endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5057" },
    { "key": "userRequestId", "value": "" },
    { "key": "coreCrudId", "value": "" }
  ],
  "item": [
    {
      "name": "Shared Platform",
      "item": [
        { "name": "Runtime", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/runtime" } },
        { "name": "Health", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/health" } },
        { "name": "Capability Catalog", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/catalog" } },
        { "name": "OpenAPI", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/swagger/v1/swagger.json" } }
      ]
    },
    {
      "name": "Core CRUD Engine",
      "item": [
        {
          "name": "Create",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Created', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.collectionVariables.set('coreCrudId', body.id);",
            "pm.test('Initial version', () => pm.expect(body.version).to.eql(1));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Core Record\"\n}" },
            "url": "{{baseUrl}}/api/core-crud",
            "description": "CoreCrudCreateRequest -> generic CRUD service -> Workbench EF/SQL -> CoreCrudResponse."
          }
        },
        {
          "name": "List",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/core-crud?page=1&pageSize=20" }
        },
        {
          "name": "Get",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/core-crud/{{coreCrudId}}" }
        },
        {
          "name": "Update",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Updated', () => pm.response.to.have.status(200));",
            "pm.test('Version advanced', () => pm.expect(pm.response.json().version).to.eql(2));"
          ] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Core Record Updated\",\n  \"expectedVersion\": 1\n}" },
            "url": "{{baseUrl}}/api/core-crud/{{coreCrudId}}",
            "description": "CoreCrudUpdateRequest includes the expected version used by the host concurrency policy."
          }
        },
        {
          "name": "Stale Update Returns Conflict",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Conflict', () => pm.response.to.have.status(409));"
          ] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Stale Update\",\n  \"expectedVersion\": 1\n}" },
            "url": "{{baseUrl}}/api/core-crud/{{coreCrudId}}"
          }
        },
        {
          "name": "Delete",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Deleted', () => pm.response.to.have.status(204));"
          ] } }],
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/core-crud/{{coreCrudId}}" }
        }
      ]
    },
    {
      "name": "Connected User/Admin Reference",
      "item": [
        {
          "name": "Create User Request",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Created', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.collectionVariables.set('userRequestId', body.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"projectName\": \"Reference System\",\n  \"projectType\": \"Internal platform\",\n  \"audience\": \"Engineering team\",\n  \"goal\": \"Verify the executable architecture reference against SQL Server.\",\n  \"selectedCapabilityIds\": [\"commands-queries\", \"ef-repository\"],\n  \"priorities\": \"Correctness and maintainability\",\n  \"notes\": \"Public-safe Workbench example\"\n}" },
            "url": "{{baseUrl}}/api/user/requests"
          }
        },
        { "name": "Submitted Queue", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/admin/requests?status=submitted" } },
        {
          "name": "Approve",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"decision\": \"approve\",\n  \"reviewedBy\": \"Reference Admin\",\n  \"notes\": \"Validated from Workbench Postman collection\"\n}" },
            "url": "{{baseUrl}}/api/admin/requests/{{userRequestId}}/review"
          }
        },
        { "name": "Get User Status", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/user/requests/{{userRequestId}}" } }
      ]
    }
  ]
}
